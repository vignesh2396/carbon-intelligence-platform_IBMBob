# ============================================================
# .env.example — Enterprise Carbon Intelligence Platform
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────
# Google Gemini API key (preferred per capstone guidelines)
GOOGLE_API_KEY=PASTE_YOUR_GOOGLE_GEMINI_API_KEY_HERE

# IBM Watsonx API key (fallback / enterprise alternative)
# WATSONX_API_KEY=your_watsonx_api_key_here
# WATSONX_PROJECT_ID=your_watsonx_project_id_here
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Application Settings ──────────────────────────────────────
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ── RAG Settings ──────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=carbon_knowledge_base
RAG_TOP_K=5
RAG_CONFIDENCE_THRESHOLD=0.6

# ── Database Settings ─────────────────────────────────────────
SQLITE_DB_PATH=./data/carbon_db.sqlite

# ── Logging Settings ─────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/agent_activity.log
